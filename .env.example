# Application
APP_NAME=NUBL
APP_ENV=local
APP_KEY=
APP_DEBUG=true
# Use the same host you open in the browser (http://127.0.0.1:8000 vs http://localhost:8000 are different sites for cookies).
APP_URL=http://localhost:8000
TRUSTED_PROXIES=127.0.0.1
APP_LOCALE=ar
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

# Logging
# LOG_CHANNEL=nightwatch  # enable when Nightwatch is configured
NIGHTWATCH_TOKEN=
LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug
# LOG_LEVEL=error  # use error in production

# Database (Docker: DB_HOST=mysql, DB_DATABASE=nubl, DB_USERNAME=nubl, DB_PASSWORD=secret)
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=nubl
DB_USERNAME=
DB_PASSWORD=

# Session
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SAME_SITE=lax
# SESSION_SECURE_COOKIE=true  # enable in production (requires HTTPS)

# Queue, cache, broadcast, files (Docker auto-sets redis for cache/session/queue)
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

# Verification & integrations
PHONE_VERIFICATION_ENABLED=true
EMAIL_VERIFICATION_ENABLED=true

# Taqnyat SMS (https://taqnyat.sa)
TAQNYAT_BEARER_TOKEN=
TAQNYAT_SENDER_NAME=NUBL

MYFATOORAH_API_KEY=
MYFATOORAH_COUNTRY_CODE=SAU
MYFATOORAH_IS_TEST=true

# Mail (Mailtrap: https://mailtrap.io)
MAIL_MAILER=log
MAIL_HOST=sandbox.smtp.mailtrap.io
MAIL_PORT=2525
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="noreply@nubl.com"
MAIL_FROM_NAME="${APP_NAME}"
SCHEDULER_TEST_MODE=false
# Mailgun
MAILGUN_DOMAIN=
MAILGUN_SECRET=
MAILGUN_ENDPOINT=api.eu.mailgun.net


# Frontend
VITE_APP_NAME="${APP_NAME}"

# Redis / Memcached / AWS (Docker: REDIS_HOST=redis)
# Use 'predis' locally (no PHP extension needed) or 'phpredis' in Docker/production
REDIS_CLIENT=predis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379
MEMCACHED_HOST=127.0.0.1

# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_DEFAULT_REGION=us-east-1
# AWS_BUCKET=
# AWS_USE_PATH_STYLE_ENDPOINT=false

# HTTP rate limiting (named limiters; see config/rate_limiting.php and docs/RATE_LIMITING.md)
RATE_LIMITING_ENABLED=true

# Optional
SANCTUM_STATEFUL_DOMAINS=localhost,127.0.0.1
QR_TTL_MINUTES=180
DEBUGBAR_ENABLED=false
NIGHTWATCH_INGEST_URI=127.0.0.1:2407
# FORGE_HEARTBEAT_URL=
# ACTIVITY_LOGGER_ENABLED=true
# DEBUGBAR_COLLECTORS_MAIL=false
# ASSET_URL=
# APP_MAINTENANCE_STORE=database
# CACHE_PREFIX=
